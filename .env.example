# Salin file ini menjadi .env lalu isi nilai aslinya (.env TIDAK ikut terpush ke GitHub)

# Server
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hunian_sewa

# JWT (NFR-04: token berumur 2 jam)
JWT_SECRET=ganti-dengan-string-acak-panjang

# Midtrans Snap (diisi saat task 7.4 — dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# URL publik untuk webhook saat development (hasil ngrok, mis. https://xxxx.ngrok-free.app)
WEBHOOK_URL=
